# Response headers for Cloudflare Workers static assets, which reads this file from the
# built site and doesn't serve it. Every other path keeps Cloudflare's default, which
# revalidates on each request, so a deploy shows at once.

# Zensical names its own scripts and stylesheets by content hash, so a URL never changes.
/assets/javascripts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/stylesheets/*
  Cache-Control: public, max-age=31536000, immutable

# The fonts keep their names when they change, but they rarely do, and a stale font only
# looks different.
/assets/fonts/*
  Cache-Control: public, max-age=604800
