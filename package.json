{
  "name": "awesome-humans-website",
  "private": true,
  "description": "Prose and configuration checks for this repository. The site itself builds with Python: see pyproject.toml.",
  "scripts": {
    "format": "prettier --prose-wrap preserve --write \"**/*.{md,json,jsonc,yml,yaml,css,js}\"",
    "format:check": "prettier --prose-wrap preserve --check \"**/*.{md,json,jsonc,yml,yaml,css,js}\"",
    "lint": "markdownlint-cli2",
    "typecheck": "pyright",
    "spell": "cspell lint --no-progress --dot \"**/*.{md,py,yml,yaml,json,jsonc,toml,css,js,html}\"",
    "check": "npm run format:check && npm run lint && npm run spell"
  },
  "devDependencies": {
    "cspell": "10.3.6",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.10",
    "pyright": "1.1.414"
  },
  "overrides": {
    "katex": "0.19.0",
    "smol-toml": "1.9.1"
  }
}
