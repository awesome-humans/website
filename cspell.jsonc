{
  // Spell checking for this repository. Run via `npm run spell` or `npm run check`,
  // which use the version pinned in package.json. Editors with a cspell extension
  // read this file too, so the editor and CI flag the same words.
  "version": "0.2",

  // British spelling, per AGENTS.md: Spelling. The flagWords below catch the
  // American forms en-GB misses.
  "language": "en-GB",
  "dictionaries": [
    "softwareTerms",
    "python",
    "css",
    "html",
    "npm",
    "bash",
    "repository-words"
  ],

  // Names, identifiers, and terms the dictionaries lack. addWords lets the
  // editor's "add to dictionary" action write here.
  "dictionaryDefinitions": [
    {
      "name": "repository-words",
      "path": "./cspell.words.txt",
      "addWords": true
    }
  ],

  "useGitignore": true,
  // build/ holds pages staged from the ecosystems, which each ecosystem checks
  // at source. The others are machine-written.
  "ignorePaths": ["node_modules", "build", "package-lock.json", "uv.lock"],

  "overrides": [
    {
      // Skip what AGENTS.md: Scope of these rules keeps as written: link text
      // (usually a third-party title), inline code (an identifier someone else
      // named), and a quotation.
      "filename": "**/*.md",
      "ignoreRegExpList": [
        "/\\[[^\\]\\n]*\\]\\(/g",
        "/`[^`\\n]+`/g",
        "/\"[^\"\\n]*\"/g"
      ],
      // The software dictionaries accept these because API names use them, so
      // en-GB alone lets them through in prose. Code files aren't covered: an
      // identifier keeps its platform's spelling.
      // cspell:disable
      "flagWords": [
        "behavior",
        "behaviors",
        "behavioral",
        "color",
        "colors",
        "colored",
        "defense",
        "defenses",
        "catalog",
        "catalogs",
        "modeling",
        "modeled",
        "favor",
        "favors",
        "favorite",
        "honor",
        "center",
        "centered",
        "analyze",
        "analyzed",
        "analyzes",
        "analyzing",
        "practiced",
        "canceled",
        "canceling",
        "labeled",
        "labeling",
        "traveled",
        "fulfill",
        "judgment",
        "gray"
      ]
      // cspell:enable
    }
  ]
}
