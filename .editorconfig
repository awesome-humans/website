# Editor settings for this repository's prose, configuration, and scripts.
#
# Values here match what the formatters produce, so the editor and a formatter
# don't undo each other on save: Prettier (`just format`) for Markdown, JSON,
# JSONC, YAML, CSS, and JavaScript, taplo for TOML, and Ruff for Python.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown: two trailing spaces are a hard line break, so trimming them changes
# the rendered output. Prettier preserves them, and the editor must too.
# indent_size is unset because Markdown nesting is content, not indentation:
# an ordered-list continuation lines up under "1. " at three columns.
[*.md]
trim_trailing_whitespace = false
indent_size = unset

# Python follows PEP 8.
[*.py]
indent_size = 4

# The four-space indent that `just --fmt` writes.
[justfile]
indent_size = 4
